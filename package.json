{
  "name": "iterm2-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Project workspaces in iTerm2 with native panes or Herdr",
  "type": "module",
  "bin": {
    "iterm2-launch": "dist/bin/iterm2-launch.js"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "release": "npm run build && node scripts/package-release.ts"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
