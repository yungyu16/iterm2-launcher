{
    "name": "iterm2-launcher",
    "version": "0.1.4",
    "private": true,
    "description": "Project workspaces in iTerm2 with native panes or Herdr",
    "type": "module",
    "bin": {
        "iterm2-launch": "dist/src/bin.js"
    },
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
        "check": "tsc --noEmit",
        "test": "npm run build && node --test test/*.test.js",
        "release": "npm run build && node scripts/package-release.ts",
        "format": "prettier --write \"{src,scripts,test}/**/*.{ts,js}\" \"*.json\" \".github/workflows/*.yml\"",
        "format:check": "prettier --check \"{src,scripts,test}/**/*.{ts,js}\" \"*.json\" \".github/workflows/*.yml\"",
        "test:package": "node scripts/release.ts verify-package"
    },
    "dependencies": {
        "smol-toml": "1.9.1"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "prettier": "3.9.10",
        "typescript": "7.0.2"
    }
}
